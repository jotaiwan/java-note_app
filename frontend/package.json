  },
  "scripts": {
    "start": "react-scripts start",
    "start:local": "react-scripts start",
    "start:docker-backend": "react-scripts start --docker-backend",
    "start:docker": "HOST=0.0.0.0 PORT=3000 IN_DOCKER=true react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
